.ruff_cache/
.claude/

# python temp paths
__pycache__/
*.py[cod]

*.blend
*.blend1
*.blend2

.vscode/settings.json
 
*.las
*.hdf5
*.ply
*.csv
*.png
output*/
*.xml

*.zip
range_scanner-*.zip

# local external/vendor clones
external/

# local notes (never committed)
notes/

# generated validation artifacts (but keep committed test fixtures)
*_report.json
*_validation_summary.json
*.metadata.json
generated_scenes/
generated_scenes_multi_seed/

# keep committed evidence under validation/ even though generic patterns above
# would otherwise exclude .png, *_report.json, and .npy files
!validation/
!validation/**
!validation/images/*.png
!validation/reports/*_report.json
!validation/reference_data/*.npy
