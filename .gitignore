.DS_Store
.ruff_cache/
.claude/

# python temp paths
__pycache__/
*.py[cod]

# Blender scene files — committed examples in example_scenes/ are exempt
*.blend
*.blend1
*.blend2
!example_scenes/*.blend

.vscode/settings.json

# large binary scan exports (can appear anywhere a scan runs)
*.las
*.hdf5

# generated scene directories (large, reproducible, not source of truth)
generated_scenes/
generated_scenes_multi_seed/

# scan output that lands inside example_scenes/output/ or generated_scenes/
example_scenes/output/

# local external/vendor clones
external/

# local notes (never committed)
notes/

# build artefacts
*.zip
range_scanner-*.zip
